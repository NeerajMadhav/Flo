# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-32-char-string-min
BACKEND_URL=https://your-app.up.railway.app

# Database — SQLite (local) or Neon Postgres (pooled URL is fine)
# Neon example: postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Flo auto-rewrites this to postgresql+asyncpg and Neon-safe pool settings.
DATABASE_URL=sqlite+aiosqlite:///./flo.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# OpenRouter NLP — each role: primary + 3 role fallbacks, then global last resort
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PARSE / EDIT / CLARIFY
NLP_PARSE_MODEL=baidu/ernie-5.5-flash-preview:free
NLP_PARSE_FALLBACK_1=google/gemma-4-31b-it:free
NLP_PARSE_FALLBACK_2=liquid/lfm-3-1.7b:free
NLP_PARSE_FALLBACK_3=inclusionai/ling-3.2-flash:free
# REPORT / INSIGHTS
NLP_REPORT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
NLP_REPORT_FALLBACK_1=thinkingmachines/inkling-2-small:free
NLP_REPORT_FALLBACK_2=nvidia/nemotron-3.5-super-vl:free
NLP_REPORT_FALLBACK_3=baidu/ernie-5.5-flash-preview:free
# Tried after every role chain is exhausted
NLP_GLOBAL_FALLBACK_MODEL=openrouter/free
NLP_MAX_TOKENS=500
NLP_TEMPERATURE=0.1
NLP_TIMEOUT_SECONDS=10
NLP_MAX_RETRIES=1
NLP_MAX_CONCURRENT=8

# API / JWT
API_SECRET_KEY=change-me-to-a-random-32-char-string-min
JWT_EXPIRE_HOURS=720

# App
TIMEZONE=Asia/Kolkata
DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO
BOT_MODE=polling
JWT_EXPIRE_HOURS=168
WEBHOOK_RATE_LIMIT_PER_MIN=120

# Scheduler (IST)
WEEKLY_REPORT_DAY=6
WEEKLY_REPORT_HOUR=20
MONTHLY_REPORT_DAY=1

# Rate limits / validation
RATE_LIMIT_MESSAGES_PER_MIN=20
RATE_LIMIT_BURST_PER_5S=5
RATE_LIMIT_API_PER_MIN=60
MAX_AMOUNT_PER_TRANSACTION=1000000
MAX_MESSAGE_LENGTH=4096
STATE_EXPIRY_MINUTES=30

# Railway — must stay at 1 (APScheduler has no distributed lock)
RAILWAY_MAX_INSTANCES=1
