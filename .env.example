# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-32-char-string-min
BACKEND_URL=https://your-app.up.railway.app

# Database (dev default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./flo.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# OpenRouter NLP
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NLP_PARSE_MODEL=google/gemini-2.0-flash-exp:free
NLP_REPORT_MODEL=anthropic/claude-3-haiku
NLP_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free
NLP_MAX_TOKENS=500
NLP_TEMPERATURE=0.1
NLP_TIMEOUT_SECONDS=10
NLP_MAX_RETRIES=1
NLP_MAX_CONCURRENT=8

# API / JWT
API_SECRET_KEY=change-me-to-a-random-32-char-string-min
JWT_EXPIRE_HOURS=720

# App
TIMEZONE=Asia/Kolkata
DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO
BOT_MODE=polling
JWT_EXPIRE_HOURS=168
WEBHOOK_RATE_LIMIT_PER_MIN=120

# Scheduler (IST)
WEEKLY_REPORT_DAY=6
WEEKLY_REPORT_HOUR=20
MONTHLY_REPORT_DAY=1

# Rate limits / validation
RATE_LIMIT_MESSAGES_PER_MIN=20
RATE_LIMIT_BURST_PER_5S=5
RATE_LIMIT_API_PER_MIN=60
MAX_AMOUNT_PER_TRANSACTION=1000000
MAX_MESSAGE_LENGTH=4096
STATE_EXPIRY_MINUTES=30

# Railway — must stay at 1 (APScheduler has no distributed lock)
RAILWAY_MAX_INSTANCES=1
